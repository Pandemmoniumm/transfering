{
  "position": "top",
  "height": 34,
  "spacing": 30,

  "modules-left": [
    "river/tags"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "pulseaudio",
    "cpu",
    "memory",
    "network"
  ],

  // MODULE CONFIGURATIONS
  "river/tags": {
    "num-tags": 9,
    "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9"]
  },
  "clock": {
    "format": "{:%H:%M:%S}",
    "interval": 1
  },
  "cpu": {
    "format": "CPU: {}%",
    "interval": 1
  },
  "memory": {
    "format": "Memory: {percentage}%",
    "tooltip-format": "Available: {avail}GiB\nUsed: {used}GiB\nTotal: {total}GiB",
    "interval": 1
  }
}
